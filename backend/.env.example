# Required security secrets. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTH_SECRET=
DATA_ENCRYPTION_KEY=
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=系统管理员

# Remote LLM (OpenAI-compatible). Required for contract review.
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# Optional local Ollama base (health check / mask model)
OLLAMA_BASE=http://localhost:11434

# Security and browser origin settings
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ACCESS_TOKEN_MINUTES=480
ENABLE_MASKING=true
SMART_MASK=true
MASK_LLM_API_BASE=http://localhost:11434/v1
MASK_LLM_API_KEY=ollama
MASK_LLM_MODEL=
MASK_LLM_NATIVE_OLLAMA=true
MASK_LLM_THINK=false
MASK_LLM_MAX_OUTPUT=160
MASK_LLM_DEEP_SCAN=false
