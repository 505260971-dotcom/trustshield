# Bootstrap security secrets. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTH_SECRET=
DATA_ENCRYPTION_KEY=
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=系统管理员

# Browser and token settings. These are deployment-level controls rather than
# model-provider settings.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ACCESS_TOKEN_MINUTES=480

# Credit-Agent policy boundaries. Model endpoints, model names and API keys are
# deliberately not configured here: sign in as the administrator and maintain
# them in 系统设置, where they are Fernet-encrypted in contractguard.db.
CREDIT_AUDIT_AGENT_ENABLED=true
CREDIT_AUDIT_AGENT_MAX_TASKS=8
# ReAct source-evidence executor tool-call ceiling.  It remains fail-closed
# after this many steps, but records every action and Claim-validation result.
CREDIT_REACT_AGENT_MAX_STEPS=16
CREDIT_AUDIT_MAX_FINANCIAL_AGE_YEARS=2
CREDIT_AUDIT_MAX_EXPOSURE_AGE_DAYS=7

# OCR for scanned PDFs/images. Tesseract must be installed separately. On
# Windows set TESSERACT_CMD when tesseract.exe is not on PATH.
CONTRACTGUARD_OCR_LANGUAGES=chi_sim+eng
TESSERACT_CMD=
TESSDATA_PREFIX=
